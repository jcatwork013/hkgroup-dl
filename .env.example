# HKGROUP — biến môi trường (copy sang .env, KHÔNG commit .env)

# --- HTTP ---
API_PORT=8090
APP_ENV=development

# --- PostgreSQL (khớp docker-compose: cổng host 5441) ---
DATABASE_URL=postgres://hk:hk@localhost:5441/hkgroup?sslmode=disable
# Prod (docker-compose.prod.yml): BẮT BUỘC set, không có default trong VCS
POSTGRES_PASSWORD=change-me-in-prod

# --- Redis ---
REDIS_URL=redis://localhost:6395/0

# --- NATS JetStream ---
NATS_URL=nats://localhost:4232

# --- Auth ---
JWT_SECRET=dev-change-me-in-prod-please-32bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- Nghiệp vụ tiền (rate cấu hình được; KHÔNG hardcode rải rác) ---
# Affiliate 1 tầng = 10%; Quỹ Đồng Chia 5%; Shareholder Pool 15% (chỉ ghi ví, T9 gated)
ALLOC_AFFILIATE_BPS=1000
ALLOC_COMMUNITY_BPS=500
ALLOC_SHAREHOLDER_BPS=1500
# Hub theo level (basis points): L1=1500, L2=2000, L3=2500
HUB_RATE_L1_BPS=1500
HUB_RATE_L2_BPS=2000
HUB_RATE_L3_BPS=2500

# --- Cửa sổ rút hoa hồng (ngày trong tháng) ---
WITHDRAW_WINDOW_START=15
WITHDRAW_WINDOW_END=30

# --- Community Pool eligible threshold (VND) ---
COMMUNITY_ELIGIBLE_MIN=1000000

# --- Hub level theo lũy kế nhập (ĐÃ CHỐT: L1<50tr · L2[50,100)tr · L3>=100tr) ---
HUB_LEVEL_L2_MIN=50000000
HUB_LEVEL_L3_MIN=100000000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_SITE_URL=http://localhost:3000
