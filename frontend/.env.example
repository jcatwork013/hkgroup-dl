# Frontend env (copy sang .env.local)

# Backend RIÊNG của shop (affiliate/auth...)
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Catalog sản phẩm lấy từ HK SHAREHOLDER (hkgroup-dl-invest).
# - NEXT_PUBLIC_INVEST_API_URL: base CÔNG KHAI (trình duyệt tải ảnh tương đối nếu có).
# - INVEST_INTERNAL_API_URL: base NỘI BỘ để server RSC fetch (docker network); mặc định = public.
NEXT_PUBLIC_INVEST_API_URL=http://localhost:8080
INVEST_INTERNAL_API_URL=http://localhost:8080
# Prod ví dụ (api-web.duoclieuhk.vn → nginx → invest API container :18080):
#   NEXT_PUBLIC_INVEST_API_URL=https://api-web.duoclieuhk.vn
#   INVEST_INTERNAL_API_URL=https://api-web.duoclieuhk.vn
#   (nếu shop chạy chung docker network với invest api thì đặt INVEST_INTERNAL_API_URL=http://api:8080)
